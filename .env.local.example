# resume.ai — local development environment.
#
# Copy this to `.env.local` and fill in the values. Most defaults come
# from the upstream dashboards (Anthropic, Clerk, Stripe, Convex, etc.)
# — never check actual secrets into git.
#
# This file documents the Next.js / Vercel side ONLY. Convex has its
# OWN env vars set via `npx convex env set`. See ENV_VARS.md at the
# repo root for the canonical Vercel-vs-Convex split.

# ─── Anthropic ────────────────────────────────────────────────────────
# Used by convex/ai/* via server-side calls. Set on BOTH Convex prod
# (via `convex env set`) AND Vercel if any Next.js route needs it.
ANTHROPIC_API_KEY=sk-ant-...

# ─── Clerk (https://dashboard.clerk.com) ──────────────────────────────
# pk_test_* in dev / pk_live_* in prod. Set in Vercel env per environment.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk JWT template named "convex" — issuer domain for Convex auth.
# Set on BOTH Vercel (for Next.js) AND Convex (for the JWT validator).
CLERK_JWT_ISSUER_DOMAIN=https://apparent-deer-88.clerk.accounts.dev

# ─── Stripe (https://dashboard.stripe.com) ────────────────────────────
# Test mode for dev, LIVE mode for prod. Set on BOTH Vercel (for the
# checkout API route) AND Convex (for the webhook handler).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# v4 credit-pack price IDs (one-time payment mode).
STRIPE_SINGLE_PRICE_ID=price_...
STRIPE_5PACK_PRICE_ID=price_...
STRIPE_20PACK_PRICE_ID=price_...
# Legacy subscription tier IDs. Code requires them (buildPriceTierMap
# throws if missing) but the credit-pack flow never reads them. Safe
# to point at the 5-pack / 20-pack price IDs as placeholders.
STRIPE_PRO_PRICE_ID=price_...
STRIPE_CAREER_PRICE_ID=price_...

# ─── Convex (https://dashboard.convex.dev) ────────────────────────────
# Public URL is inlined into the client bundle so it can subscribe to
# queries. Site URL is the HTTP-handler endpoint Stripe webhooks point
# at. Both are auto-set by `npx convex deploy --cmd ...` during the
# Vercel build; only set them locally if you want to point dev at a
# specific deployment.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
# Used by `convex deploy` in CI/Vercel only — local dev uses
# `convex dev` and stores creds in ~/.convex.
CONVEX_DEPLOY_KEY=

# ─── Scraping ─────────────────────────────────────────────────────────
# Firecrawl handles JD fetching. Set on Convex prod (the scrape runs
# inside a Convex action, not a Next.js API route).
FIRECRAWL_API_KEY=fc-...

# ─── Anti-abuse ───────────────────────────────────────────────────────
# Salts the per-browser fingerprint hash for anonymous rate-limiting.
# Rotate ~weekly; min 32 chars. Set on Vercel only — Convex doesn't
# read this directly (the hash arrives over the wire pre-salted).
FINGERPRINT_SALT=

# ─── Public site URL ──────────────────────────────────────────────────
# Used in layout.tsx for metadataBase (OG image URLs, sitemap, etc.).
# Set per environment; falls back to the canonical Vercel preview URL
# when unset.
NEXT_PUBLIC_SITE_URL=https://resume-ai-kappa-rouge.vercel.app
